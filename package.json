{
  "name": "fami-li-adventures",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@fami-li/web",
    "build": "npm run build --workspace=@fami-li/web && node scripts/prepare-static.mjs",
    "start": "npm run start --workspace=@fami-li/web",
    "typecheck": "npm run typecheck --workspace=@fami-li/web",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write . --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "serve": {
      "compression": "^1.8.2"
    }
  }
}
